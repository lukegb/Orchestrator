{% for deployment in deployments %}
{% for port in deployment.ports %}
{% set canonical_name = port.hostname(app_config) %}
server {
  listen *:80;
  listen [::]:80;


  server_name {{ canonical_name }};

  index  index.html index.htm;
  access_log            /var/log/nginx/access.log;
  error_log             /var/log/nginx/error.log;

  location /.well-known/acme-challenge/ {
    alias /var/www/.well-known/acme-challenge/;
    index     index.html index.htm;
  }

  location / {
    rewrite ^ https://{{ canonical_name }}$request_uri? permanent;
    index     index.html index.htm;
  }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name {{ canonical_name }};

    include "snippets/ssl-common.conf";
    ssl_certificate /etc/letsencrypt/live/{{ app_config.domain_suffix }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ app_config.domain_suffix }}/privkey.pem;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location /.well-known/acme-challenge/ {
        root /var/www/.well-known/acme-challenge/;
    }

    location / {
        try_files $uri @backend;
    }

    location @backend {
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;

        proxy_set_header X-Forwarded-Proto         "https";
        proxy_set_header Host                     $host;
        proxy_set_header X-Forwarded-For           $remote_addr;
        proxy_set_header X-Scheme                 $scheme;
        proxy_pass http://localhost:{{ port.port }};
    }
}
{% endfor %}
{% endfor %}